    {
      "src": "/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "相机",
      "description": "打开相机拍照",
      "short_name": "相机",
      "url": "/?tab=camera",
      "icons": [
        {
          "src": "/icon-camera-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "相册",
      "description": "查看照片相册",
      "short_name": "相册",
      "url": "/?tab=photos",
      "icons": [
        {
          "src": "/icon-photos-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photo",
          "accept": ["image/*"]
        }
      ]
    }
  }
